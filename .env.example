# Database (PostgreSQL for cloud; for local SQLite use: "file:./dev.db" and provider "sqlite" in schema.prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/quotation_db"

# Auth — REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET="change-me-to-a-long-random-string"

# Public URL of the app (used in emails/links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
